<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- マイク入力(実行時にユーザーの許可が必要な "dangerous" 権限) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- フォアグラウンドサービスを使うための権限(インストール時に自動付与) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14 (API 34) 以降必須: サービスの「種類」ごとの権限。
         type="microphone" のサービスを動かすには、これも宣言が要る -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Android 13 (API 33) 以降: 通知を出すには実行時許可が必要。
         フォアグラウンドサービスの常時通知も対象 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 一晩録音中に CPU がスリープしないようにするための WakeLock(自動付与) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.SleepRec">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <!-- ランチャーから起動できるようにする「入口」の宣言 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- クリップの共有(FR-4.8)。共有の相手には、その 1 回だけ読める権限を渡す。外からは直接アクセスできない -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- exported=false: 他アプリからは起動させない。
             foregroundServiceType: コード側の startForeground() で渡す type の上限をここで宣言する -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
